---
import { Image } from 'astro:assets';
import plaza from '../assets/fotos/plaza.jpg';
import plancha from '../assets/fotos/arepas-plancha.jpg';
---
<section class="plaza" aria-labelledby="plaza-t">
  <div class="wrap plaza-grid">
    <div class="plaza-txt">
      <span class="etiqueta plaza-tag">Cómo cocinamos</span>
      <h2 id="plaza-t" class="letrero plaza-h" data-reveal="words">De la plaza a la olla, todos los días.</h2>
      <ol class="pasos">
        <li><span class="letrero">6 a. m.</span> Compramos papa, mazorca y guascas en la plaza de mercado.</li>
        <li><span class="letrero">8 a. m.</span> Prendemos la leña. El fogón no se apaga hasta el cierre.</li>
        <li><span class="letrero">12 m.</span> Sale el primer ajiaco. Cuando se acaba, se acaba.</li>
      </ol>
    </div>
    <figure class="plaza-foto plaza-foto--a" data-polaroid>
      <Image src={plaza} alt="Puesto de plaza de mercado lleno de frutas frescas y canastos" widths={[360, 600, 800]} sizes="(min-width: 1100px) 28vw, 70vw" quality={66} />
      <figcaption>La plaza, temprano.</figcaption>
    </figure>
    <figure class="plaza-foto plaza-foto--b" data-polaroid>
      <Image src={plancha} alt="Manos volteando arepas de maíz sobre una plancha caliente" widths={[360, 600, 800]} sizes="(min-width: 1100px) 26vw, 70vw" quality={66} />
      <figcaption>Arepas en la plancha.</figcaption>
    </figure>
  </div>
</section>

<style>
  .plaza { background: var(--hoja); color: var(--papel); border-block: var(--borde); padding-block: 72px 96px; overflow: hidden; }
  .plaza-grid { display: grid; gap: 40px; }
  .plaza-txt { display: grid; gap: 22px; justify-items: start; align-content: start; }
  .plaza-tag { background: var(--maiz); color: var(--tinta); }
  .plaza-h { font-size: clamp(2.25rem, 1.3rem + 4vw, 4.5rem); max-width: 14ch; color: var(--papel); }
  .pasos { display: grid; gap: 0; width: 100%; max-width: 46ch; }
  .pasos li { display: grid; grid-template-columns: 96px 1fr; gap: 16px; padding-block: 14px; border-top: 2px solid rgba(251, 243, 228, 0.35); }
  .pasos .letrero { color: var(--maiz); font-size: 1.375rem; }

  .plaza-foto { background: var(--papel); padding: 10px 10px 0; border: var(--borde); box-shadow: var(--sombra); color: var(--tinta); }
  .plaza-foto :global(img) { aspect-ratio: 4 / 5; object-fit: cover; width: 100%; }
  .plaza-foto figcaption { padding: 10px 2px 12px; font-weight: 700; font-size: 0.9375rem; }
  .plaza-foto--a { transform: rotate(-3deg); width: 78%; }
  .plaza-foto--b { transform: rotate(4deg); width: 72%; justify-self: end; margin-top: -80px; }

  @media (min-width: 1100px) {
    .plaza { padding-block: 112px 128px; }
    .plaza-grid { grid-template-columns: 5fr 3fr 3fr; gap: 40px; align-items: start; }
    .plaza-foto--a { width: 100%; margin-top: 40px; }
    .plaza-foto--b { width: 100%; margin-top: 140px; }
  }
</style>
