---
import WhatsAppLink from '@altair/core/WhatsAppLink.astro';
import { contacto, creditos, demo, mensajes, negocio } from '../../site.config';
---
<footer class="pie-sitio on-dark">
  <div class="wrap">
    <div class="pie-top">
      <p class="serif pie-marca" aria-hidden="true">Filo</p>
      <div class="pie-cta">
        <p class="serif pie-frase">¿Le guardamos la silla?</p>
        <WhatsAppLink class="cta cta--claro" telefono={contacto.whatsapp} mensaje={mensajes.general}>
          Escribir a {negocio.nombreCorto} <span class="flecha" aria-hidden="true">→</span>
        </WhatsAppLink>
      </div>
    </div>
    <hr class="rule" />
    <div class="pie-bajo">
      <p>
        {negocio.nombre} es un <strong>negocio ficticio</strong>. Esta página es una demostración del plan Esencial de
        <a class="enlace" href={demo.url}>Altair Studio</a>: precios, horarios y dirección son de ejemplo.
      </p>
      <p class="creditos">
        Fotos de Unsplash (licencia Unsplash):
        {creditos.map((c, i) => (
          <>
            <a class="enlace" href={c.url} target="_blank" rel="noopener">{c.autor}</a>{i < creditos.length - 1 ? ', ' : '.'}
          </>
        ))}
      </p>
    </div>
  </div>
</footer>

<style>
  .pie-sitio { background: var(--tinta); color: var(--crema); padding-block: 72px 40px; }
  .pie-top { display: grid; gap: 28px; margin-bottom: 40px; }
  .pie-marca { font-size: clamp(6rem, 3rem + 18vw, 18rem); line-height: 0.8; color: #7a2a30; }
  .pie-cta { display: grid; gap: 18px; justify-items: start; align-content: end; }
  .pie-frase { font-size: clamp(1.75rem, 1.2rem + 2vw, 2.75rem); }
  .pie-bajo { display: grid; gap: 14px; padding-top: 24px; font-size: 0.875rem; color: rgba(243, 233, 215, 0.82); max-width: 80ch; }
  .pie-bajo strong { color: var(--crema); }
  .creditos a { color: var(--crema); }
  @media (min-width: 768px) {
    .pie-top { grid-template-columns: 1fr auto; align-items: end; }
  }
</style>
