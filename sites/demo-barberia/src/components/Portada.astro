---
import { Image } from 'astro:assets';
import WhatsAppLink from '@altair/core/WhatsAppLink.astro';
import silla from '../assets/fotos/silla-ventana.jpg';
import { contacto, mensajes, negocio, ubicacion } from '../../site.config';
---
<section class="portada" aria-labelledby="portada-t">
  <div class="wrap portada-grid">
    <div class="portada-texto">
      <p class="kicker portada-kicker" data-in>
        <span>{negocio.edicion}</span><span>{ubicacion.barrio}</span><span>{ubicacion.ciudad}</span>
      </p>
      <hr class="rule rule--double" />
      <h1 id="portada-t" class="serif portada-h" data-hero-title>{negocio.lema}</h1>
      <p class="portada-dek" data-in>
        Barbería clásica y spa en una casa de {ubicacion.barrio}. Aquí no hay turnos a la suerte: usted reserva por
        WhatsApp y su silla lo espera a la hora acordada.
      </p>
      <div class="portada-cta" data-in>
        <WhatsAppLink class="cta" telefono={contacto.whatsapp} mensaje={mensajes.general}>
          Reservar por WhatsApp <span class="flecha" aria-hidden="true">→</span>
        </WhatsAppLink>
        <a class="enlace" href="#servicios">Ver servicios y precios</a>
      </div>
    </div>

    <figure class="portada-foto">
      <div class="portada-marco">
        <Image
          src={silla}
          alt="Silla de barbero antigua junto a una puerta abierta por la que entra la luz de la tarde"
          widths={[400, 640, 900, 1200]}
          sizes="(min-width: 1200px) 38vw, (min-width: 768px) 44vw, 92vw"
          loading="eager"
          fetchpriority="high"
          quality={70}
          data-hero-img
        />
      </div>
      <figcaption class="pie" data-in><span>Fig. 1</span> La silla del fondo, a las tres de la tarde.</figcaption>
    </figure>
  </div>

  <nav class="wrap indice" aria-label="En esta página">
    <p class="kicker">En esta edición</p>
    <ol>
      <li><a href="#casa"><span class="serif">I.</span> La casa</a></li>
      <li><a href="#servicios"><span class="serif">II.</span> La carta</a></li>
      <li><a href="#galeria"><span class="serif">III.</span> Galería</a></li>
      <li><a href="#reserva"><span class="serif">IV.</span> Reservas</a></li>
      <li><a href="#visita"><span class="serif">V.</span> Visítenos</a></li>
    </ol>
  </nav>
</section>

<style>
  .portada { padding-top: 28px; }
  .portada-grid { display: grid; gap: 36px; }
  .portada-kicker { display: flex; flex-wrap: wrap; gap: 6px 18px; color: var(--vino); margin-bottom: 14px; }
  .portada-kicker span + span::before { content: '·'; margin-right: 18px; color: var(--laton); }
  .portada-h {
    font-size: clamp(2.9rem, 1.6rem + 6.4vw, 7.25rem);
    margin: 22px 0 26px;
    color: var(--tinta);
    text-wrap: balance;
  }
  .portada-dek { font-size: 1.1875rem; line-height: 1.55; max-width: 34ch; color: var(--tinta-2); }
  .portada-cta { display: flex; flex-wrap: wrap; align-items: center; gap: 18px 28px; margin-top: 30px; }

  .portada-foto { display: grid; gap: 12px; }
  .portada-marco { overflow: hidden; aspect-ratio: 4 / 5; background: var(--crema-2); }
  .portada-marco :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 40% 60%; }

  .pie { font-size: 0.8125rem; color: var(--tinta-2); }
  .pie span { font-family: var(--f-serif); color: var(--vino); margin-right: 6px; }

  .indice { margin-top: 56px; padding-block: 20px; border-top: 1px solid rgba(30, 20, 18, 0.2); border-bottom: 1px solid rgba(30, 20, 18, 0.2); display: grid; gap: 12px; }
  .indice .kicker { color: var(--tinta-2); }
  .indice ol { display: flex; flex-wrap: wrap; gap: 6px 26px; }
  .indice a { text-decoration: none; display: inline-flex; gap: 8px; align-items: baseline; padding-block: 8px; }
  .indice a:hover { color: var(--vino); }
  .indice .serif { color: var(--vino); font-size: 1.125rem; }

  @media (min-width: 768px) {
    .portada { padding-top: 48px; }
    .portada-grid { grid-template-columns: 7fr 5fr; gap: 48px; align-items: end; }
    .indice { grid-template-columns: auto 1fr; align-items: center; gap: 32px; margin-top: 72px; }
    .indice ol { justify-content: flex-end; }
  }
  @media (min-width: 1200px) {
    .portada-grid { grid-template-columns: 7fr 4fr; gap: 80px; }
    .portada-foto { margin-bottom: 12px; }
  }
</style>
