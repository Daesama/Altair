---
import { Image } from 'astro:assets';
import Lab from '../../layouts/Lab.astro';
import Logo from '../../brand/Logo.astro';
import WhatsAppLink from '@altair/core/WhatsAppLink.astro';
import { cop } from '@altair/core/types';
import { contacto, lanzamiento, mensajes, planes } from '../../../site.config';
import arke from '../../assets/portfolio/arke.png';
import filo from '../../assets/portfolio/barberia.png';
import lenera from '../../assets/portfolio/restaurante.png';
import sans from '../../assets/fonts/instrument-sans-latin-wght-normal.woff2?url';
import serif from '../../assets/fonts/instrument-serif-latin-400-italic.woff2?url';

const esencial = planes[0];
const ocupados = lanzamiento.cuposTotales - lanzamiento.cuposRestantes;
---
<Lab titulo="B · Bento vivo" fuentes={[sans, serif]}>
  <div class="b">
    <header class="hdr wrap">
      <a href="/lab/b" class="hdr-logo" aria-label="Altair Studio, inicio"><Logo etiqueta="" /></a>
      <nav aria-label="Principal">
        <ul class="nav">
          <li><a href="/lab/b" aria-current="page">Inicio</a></li>
          <li><a href="/planes">Planes</a></li>
          <li><a href="/portafolio">Portafolio</a></li>
          <li><a href="/proceso">Proceso</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </nav>
      <WhatsAppLink class="hdr-cta" telefono={contacto.whatsapp} mensaje={mensajes.general}>Escríbanos</WhatsAppLink>
    </header>

    <main id="contenido" class="wrap">
      <div class="grid" data-grid>
        <!-- Titular -->
        <section class="t t-hero" aria-labelledby="hero-t" data-tile>
          <p class="eyebrow" data-in>Estudio web · Bogotá</p>
          <h1 id="hero-t" class="h1" data-hero-title>Su negocio, a <em>un mensaje</em> de distancia.</h1>
          <p class="lead" data-in>Páginas web para comercios: que lo encuentren en Google, vean sus precios y le escriban por WhatsApp.</p>
          <div class="ctas" data-in>
            <WhatsAppLink class="btn" telefono={contacto.whatsapp} mensaje={mensajes.general} data-magnetic>Empezar por WhatsApp</WhatsAppLink>
            <a class="lnk" href="/planes">Ver planes →</a>
          </div>
        </section>

        <!-- Chat en vivo -->
        <div class="t t-chat" aria-hidden="true" data-tile>
          <div class="chat-top"><span class="av">A</span><span><b>Su cliente</b><small>escribiendo…</small></span></div>
          <div class="chat" data-chat>
            <p class="msg out">Hola, ¿tienen cita hoy?</p>
            <p class="msg in">¡Sí! Hay a las 4 p. m.</p>
            <p class="msg out">Perfecto, la tomo.</p>
            <p class="msg in">Listo, lo esperamos ✓</p>
          </div>
          <p class="t-cap">Los botones de WhatsApp llevan el mensaje escrito.</p>
        </div>

        <!-- Mapa -->
        <div class="t t-map" aria-hidden="true" data-tile>
          <svg class="map" viewBox="0 0 240 160" preserveAspectRatio="xMidYMid slice" data-depth="0.25">
            <path d="M-10 40h260M-10 100h260M50-10v180M140-10v180M200-10v180" stroke="#2a2537" stroke-width="10"/>
            <path d="M-10 72 250 58" stroke="#3a3350" stroke-width="16"/>
          </svg>
          <span class="pin" data-pin><svg viewBox="0 0 24 32"><path d="M12 0C5.4 0 0 5.2 0 11.6 0 20.3 12 32 12 32s12-11.7 12-20.4C24 5.2 18.6 0 12 0z" fill="#7a4bff"/><circle cx="12" cy="11.5" r="4.5" fill="#fff"/></svg></span>
          <p class="map-card"><b>Su negocio</b><span>Abierto · a 300 m</span></p>
        </div>

        <!-- Cupos -->
        <a class="t t-cupos" href="/planes" data-tile>
          <span class="tag">Lanzamiento</span>
          <p class="big"><span data-count>{lanzamiento.cuposRestantes}</span><small>/{lanzamiento.cuposTotales}</small></p>
          <p class="t-cap">cupos con precio especial</p>
          <ol class="dots" aria-hidden="true">
            {Array.from({ length: lanzamiento.cuposTotales }, (_, i) => <li class={i < ocupados ? 'off' : ''} />)}
          </ol>
        </a>

        <!-- Precio -->
        <a class="t t-price" href="/planes" data-tile>
          <span class="tag">Plan Esencial</span>
          <p class="old"><s>{cop(esencial.precioOficial)}</s></p>
          <p class="price" data-price-from={esencial.precioOficial} data-price-to={esencial.precioLanzamiento}>{cop(esencial.precioLanzamiento!)}</p>
          <p class="t-cap">Pago único. Sin mensualidad.</p>
          <span class="go">Ver los 3 planes →</span>
        </a>

        <!-- Portafolio -->
        <a class="t t-port" href="/portafolio" data-tile data-fan>
          <span class="tag tag--light">Portafolio</span>
          <h2 class="t-h">Tres páginas ya en línea</h2>
          <div class="fan" aria-hidden="true">
            <span class="card c3" data-fan-card><Image src={lenera} alt="" widths={[360, 600]} sizes="300px" /></span>
            <span class="card c2" data-fan-card><Image src={filo} alt="" widths={[360, 600]} sizes="300px" /></span>
            <span class="card c1" data-fan-card><Image src={arke} alt="" widths={[360, 600]} sizes="300px" /></span>
          </div>
        </a>

        <!-- Proceso -->
        <a class="t t-proc" href="/proceso" data-tile>
          <span class="tag">Proceso</span>
          <ol class="proc" data-proc>
            <li><span>1</span>Hablamos</li>
            <li><span>2</span>Diseñamos</li>
            <li><span>3</span>Usted revisa</li>
            <li><span>4</span>Publicamos</li>
          </ol>
          <span class="go">Cómo trabajamos →</span>
        </a>
      </div>
    </main>

    <footer class="foot wrap">
      <p>© 2026 Altair Studio · Bogotá · {contacto.whatsapp}</p>
      <p><a href="/terminos">Términos</a> · <a href="/privacidad">Datos</a></p>
    </footer>
    <div class="cursor" aria-hidden="true" data-cursor><span data-cursor-txt>Ver</span></div>
  </div>
</Lab>

<style>
  .b { font-family: 'Instrument Sans', system-ui, sans-serif; min-height: 100svh; display: flex; flex-direction: column; }
  .b :global(.logo) { height: 20px; --logo-accent: var(--violet); }
  .hdr { display: flex; align-items: center; gap: 24px; height: 72px; }
  .hdr-logo { color: var(--fg); margin-right: auto; }
  .nav { display: none; gap: 4px; }
  .nav a { display: inline-flex; height: 40px; align-items: center; padding: 0 12px; border-radius: 10px; color: var(--fg-2); text-decoration: none; font-size: 15px; transition: color .2s, background-color .2s; }
  .nav a:hover { color: var(--fg); background: var(--s1); }
  .nav a[aria-current='page'] { color: var(--fg); }
  .hdr-cta { display: inline-flex; align-items: center; height: 40px; padding: 0 16px; border-radius: 10px; background: var(--fg); color: #0b0910; font-weight: 600; font-size: 14px; text-decoration: none; }
  @media (min-width: 900px) { .nav { display: flex; } }

  main { flex: 1; padding-bottom: 24px; }
  .grid { display: grid; gap: 12px; grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .t { position: relative; overflow: hidden; display: flex; flex-direction: column; gap: 8px; min-height: 180px; padding: 20px; border-radius: 22px; background: var(--s1); border: 1px solid var(--hair); text-decoration: none; color: var(--fg); will-change: transform; }
  a.t { cursor: none; }
  .tag { align-self: flex-start; padding: 3px 10px; border-radius: 999px; border: 1px solid var(--hair-2); font-size: 12px; color: var(--fg-2); }
  .tag--light { border-color: rgba(255,255,255,.35); color: #fff; }
  .t-cap { font-size: 14px; color: var(--fg-2); }
  .go { margin-top: auto; font-weight: 600; font-size: 14px; }

  .t-hero { grid-column: 1 / -1; background: var(--bone); color: #120f1a; padding: 28px 24px; gap: 16px; justify-content: flex-end; min-height: 420px; border: 0; }
  .eyebrow { font-size: 13px; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: #5b5470; }
  .h1 { font-size: clamp(2.6rem, 1.2rem + 5.4vw, 5.75rem); line-height: .98; letter-spacing: -0.04em; font-weight: 600; max-width: 12ch; text-wrap: balance; }
  .h1 em { font-family: 'Instrument Serif', Georgia, serif; font-style: italic; font-weight: 400; letter-spacing: -0.01em; color: var(--violet-2); }
  .lead { max-width: 40ch; font-size: 1.0625rem; color: #3d3650; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 24px; }
  .btn { display: inline-flex; align-items: center; height: 52px; padding: 0 22px; border-radius: 14px; background: #120f1a; color: #fff; font-weight: 600; text-decoration: none; }
  .lnk { color: #120f1a; font-weight: 600; text-underline-offset: 4px; }

  .t-chat { grid-column: 1 / -1; background: var(--violet); border: 0; color: #fff; min-height: 300px; }
  .chat-top { display: flex; align-items: center; gap: 10px; font-size: 14px; }
  .chat-top small { display: block; font-size: 12px; opacity: .8; }
  .av { display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%; background: #fff; color: var(--violet-2); font-weight: 700; }
  .chat { display: grid; gap: 8px; margin-top: 8px; align-content: start; flex: 1; }
  .msg { max-width: 80%; padding: 9px 12px; border-radius: 14px; font-size: 14px; line-height: 1.3; }
  .msg.out { justify-self: end; background: #fff; color: #1b1030; border-bottom-right-radius: 4px; }
  .msg.in { justify-self: start; background: rgba(0,0,0,.22); border-bottom-left-radius: 4px; }
  .t-chat .t-cap { color: rgba(255,255,255,.85); }

  .t-map { padding: 0; background: #151220; }
  .map { position: absolute; inset: -20px; width: calc(100% + 40px); height: calc(100% + 40px); }
  .pin { position: absolute; left: 50%; top: 38%; width: 30px; margin-left: -15px; }
  .map-card { position: absolute; left: 12px; right: 12px; bottom: 12px; display: grid; padding: 10px 12px; border-radius: 12px; background: var(--s2); border: 1px solid var(--hair-2); font-size: 13px; }
  .map-card span { color: #4ade80; font-size: 12px; }

  .t-cupos { background: #0f1830; }
  .big { font-size: 4rem; font-weight: 600; line-height: 1; letter-spacing: -0.05em; margin-top: auto; }
  .big small { font-size: 1.5rem; color: var(--fg-3); letter-spacing: 0; }
  .dots { display: grid; grid-template-columns: repeat(10, 1fr); gap: 4px; margin-top: 8px; }
  .dots li { height: 6px; border-radius: 3px; background: var(--blue); }
  .dots li.off { background: #23304f; }

  .t-price { grid-column: 1 / -1; }
  .old { margin-top: auto; color: var(--fg-3); }
  .old s { text-decoration-color: var(--violet); text-decoration-thickness: 2px; }
  .price { font-size: clamp(2.75rem, 2rem + 3vw, 4.25rem); font-weight: 600; letter-spacing: -0.05em; line-height: 1; font-variant-numeric: tabular-nums; }

  .t-port { grid-column: 1 / -1; min-height: 320px; background: #1a1430; }
  .t-h { font-size: 1.5rem; letter-spacing: -0.02em; font-weight: 600; max-width: 14ch; }
  .fan { position: absolute; right: -10px; bottom: -40px; width: 62%; height: 78%; }
  .card { position: absolute; right: 0; bottom: 0; width: 100%; border-radius: 12px; overflow: hidden; border: 1px solid rgba(255,255,255,.18); box-shadow: 0 24px 48px -20px rgba(0,0,0,.8); transform-origin: 80% 100%; }
  .card :global(img) { width: 100%; height: auto; }
  .c1 { transform: rotate(-2deg); }
  .c2 { transform: rotate(-9deg) translateX(-14%); }
  .c3 { transform: rotate(-16deg) translateX(-28%); }

  .t-proc { grid-column: 1 / -1; }
  .proc { display: grid; gap: 6px; margin-top: 8px; }
  .proc li { display: flex; align-items: center; gap: 12px; padding: 10px 12px; border-radius: 12px; background: var(--s2); font-size: 15px; color: var(--fg-2); transition: background-color .3s, color .3s; }
  .proc li span { display: grid; place-items: center; width: 24px; height: 24px; border-radius: 8px; background: var(--s3); font-size: 12px; font-weight: 600; }
  .proc li.on { background: var(--fg); color: #0b0910; }
  .proc li.on span { background: var(--violet); color: #fff; }

  @media (min-width: 720px) {
    .grid { grid-template-columns: repeat(6, minmax(0, 1fr)); }
    .t-hero { grid-column: 1 / -1; }
    .t-chat { grid-column: 1 / span 3; }
    .t-map { grid-column: 4 / span 3; }
    .t-cupos { grid-column: 1 / span 2; }
    .t-price { grid-column: 3 / span 4; }
    .t-port { grid-column: 1 / span 4; }
    .t-proc { grid-column: 5 / span 2; }
  }
  @media (min-width: 1100px) {
    main { display: flex; }
    .grid {
      flex: 1;
      grid-template-columns: repeat(12, minmax(0, 1fr));
      grid-template-rows: minmax(200px, 1fr) minmax(200px, 1fr) minmax(220px, 1fr);
      min-height: calc(100svh - 72px - 64px - 24px);
    }
    .t-hero { grid-column: 1 / span 7; grid-row: 1 / span 2; padding: 40px; min-height: 0; }
    .t-chat { grid-column: 8 / span 5; grid-row: 1; min-height: 0; }
    .t-map { grid-column: 8 / span 3; grid-row: 2; min-height: 0; }
    .t-cupos { grid-column: 11 / span 2; grid-row: 2; min-height: 0; }
    .t-price { grid-column: 1 / span 4; grid-row: 3; }
    .t-port { grid-column: 5 / span 5; grid-row: 3; min-height: 0; }
    .t-proc { grid-column: 10 / span 3; grid-row: 3; }
    .t-chat .chat { grid-template-columns: 1fr; }
  }

  .foot { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px; height: auto; padding-block: 20px; font-size: 13px; color: var(--fg-3); }
  .foot a { color: var(--fg-2); }

  .cursor { position: fixed; left: 0; top: 0; z-index: 400; pointer-events: none; display: grid; place-items: center; width: 72px; height: 72px; margin: -36px 0 0 -36px; border-radius: 50%; background: var(--fg); color: #0b0910; font-weight: 600; font-size: 13px; transform: scale(0); }
  @media (hover: none), (pointer: coarse) { .cursor { display: none; } a.t { cursor: pointer; } }
  :global(.rm) .cursor { display: none; }
  :global(.rm) a.t { cursor: pointer; }
</style>

<script>
  import { initMotion } from '@altair/core/motion';
  import { revealText } from '@altair/core/reveal';
  import { magnetic, tilt, finePointer } from '@altair/core/pointer';
  import { cop } from '@altair/core/types';

  const m = initMotion();
  const { gsap } = m;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];

  $$('[data-magnetic]').forEach((el) => magnetic(m, el, 0.2));
  $$('a[data-tile]').forEach((el) => tilt(m, el, 3));

  // Cursor con etiqueta: crece sobre los bloques que son enlaces y dice a dónde llevan.
  const cur = document.querySelector<HTMLElement>('[data-cursor]');
  const curTxt = document.querySelector<HTMLElement>('[data-cursor-txt]');
  if (cur && curTxt && finePointer() && !m.reduced) {
    const x = gsap.quickTo(cur, 'x', { duration: 0.35, ease: 'power3.out' });
    const y = gsap.quickTo(cur, 'y', { duration: 0.35, ease: 'power3.out' });
    window.addEventListener('pointermove', (e) => { x(e.clientX); y(e.clientY); });
    $$<HTMLAnchorElement>('a[data-tile]').forEach((a) => {
      const label = a.querySelector('.go')?.textContent?.replace('→', '').trim() || 'Ver';
      a.addEventListener('pointerenter', () => { curTxt.textContent = label.split(' ')[0]; gsap.to(cur, { scale: 1, duration: 0.35, ease: 'back.out(2)' }); });
      a.addEventListener('pointerleave', () => gsap.to(cur, { scale: 0, duration: 0.25 }));
    });
  }

  // Abanico del portafolio: se abre al pasar el cursor.
  const fan = document.querySelector<HTMLElement>('[data-fan]');
  if (fan && !m.reduced) {
    const cards = $$('[data-fan-card]', fan);
    const abierto = [{ rotate: 4, x: '0%', y: -10 }, { rotate: -8, x: '-34%', y: -4 }, { rotate: -20, x: '-66%', y: 6 }];
    const cerrado = [{ rotate: -2, x: '0%', y: 0 }, { rotate: -9, x: '-14%', y: 0 }, { rotate: -16, x: '-28%', y: 0 }];
    const ir = (e: typeof abierto) => cards.slice().reverse().forEach((c, i) => gsap.to(c, { ...e[i], duration: 0.6, ease: 'power3.out' }));
    gsap.set(cards.slice().reverse(), { rotate: (i) => cerrado[i].rotate, x: (i) => cerrado[i].x });
    fan.addEventListener('pointerenter', () => ir(abierto));
    fan.addEventListener('pointerleave', () => ir(cerrado));
  }

  if (!m.reduced) {
    const t = document.querySelector('[data-hero-title]');
    if (t) revealText(m, t, { scroll: false, delay: 0.25, stagger: 0.09 });
    gsap.from('[data-tile]', { y: 30, opacity: 0, scale: 0.97, duration: 0.8, stagger: 0.07, ease: 'power3.out' });
    gsap.to('[data-in]', { opacity: 1, duration: 0.7, stagger: 0.1, delay: 0.5 });

    // Chat en bucle
    const msgs = $$('.chat .msg');
    const chat = gsap.timeline({ repeat: -1, repeatDelay: 1.6, delay: 1 });
    chat.set(msgs, { autoAlpha: 0, y: 10 });
    msgs.forEach((mm, i) => chat.to(mm, { autoAlpha: 1, y: 0, duration: 0.35, ease: 'back.out(1.6)' }, 0.4 + i * 1.1));
    chat.to(msgs, { autoAlpha: 0, duration: 0.3 }, '+=2');

    // Pin que cae y rebota
    gsap.fromTo('[data-pin]', { y: -120, opacity: 0 }, { y: 0, opacity: 1, duration: 1, ease: 'bounce.out', delay: 1.1 });

    // Proceso: se ilumina paso a paso
    const pasos = $$('[data-proc] li');
    let k = 0;
    const tick = () => { pasos.forEach((p, i) => p.classList.toggle('on', i === k)); k = (k + 1) % pasos.length; };
    tick(); setInterval(tick, 1600);

    // Precio y cupos
    const pr = document.querySelector<HTMLElement>('[data-price-to]');
    if (pr) { const o = { v: Number(pr.dataset.priceFrom) }; gsap.to(o, { v: Number(pr.dataset.priceTo), duration: 1.6, delay: 0.9, ease: 'power3.out', onUpdate: () => { pr.textContent = cop(Math.round(o.v / 1000) * 1000); } }); }
    const n = document.querySelector<HTMLElement>('[data-count]');
    if (n) { const fin = Number(n.textContent); const o = { v: 10 }; gsap.to(o, { v: fin, duration: 1.2, delay: 1, ease: 'power2.out', onUpdate: () => { n.textContent = String(Math.round(o.v)); } }); }
    gsap.from('.dots li', { scaleX: 0, transformOrigin: 'left', duration: 0.4, stagger: 0.05, delay: 1 });
  } else {
    gsap.set('[data-in]', { opacity: 1 });
    $$('[data-proc] li')[0]?.classList.add('on');
  }
</script>
