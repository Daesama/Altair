---
import { Image } from 'astro:assets';
import Lab from '../../layouts/Lab.astro';
import Logo from '../../brand/Logo.astro';
import WhatsAppLink from '@altair/core/WhatsAppLink.astro';
import { cop } from '@altair/core/types';
import { contacto, estrella, mensajes, planes } from '../../../site.config';
import arke from '../../assets/portfolio/arke.png';
import filo from '../../assets/lab/filo-movil.png';
import lenera from '../../assets/lab/lenera-movil.png';
import archivo from '../../assets/fonts/archivo-latin-wdth-normal.woff2?url';
import martian from '../../assets/fonts/martian-mono-latin-wdth-normal.woff2?url';

// Estrellas de fondo con posiciones fijas (semilla determinista, igual en cada build).
let s = 7;
const rnd = () => ((s = (s * 16807) % 2147483647) / 2147483647);
const fondo = Array.from({ length: 70 }, () => ({ x: rnd() * 100, y: rnd() * 100, r: rnd() < 0.15 ? 2.4 : rnd() < 0.5 ? 1.6 : 1 }));
// Triángulo de verano (mismas proporciones que el logo).
const triangulo = [
  { id: 'Altair', x: 76, y: 20 },
  { id: 'Vega', x: 60, y: 50 },
  { id: 'Deneb', x: 88, y: 58 },
];
---
<Lab titulo="C · Constelación" fuentes={[archivo, martian]}>
  <div class="c">
    <header class="hdr wrap">
      <a href="/lab/c" class="hdr-logo" aria-label="Altair Studio, inicio"><Logo etiqueta="" /></a>
      <nav aria-label="Principal">
        <ul class="nav">
          <li><a href="/planes">Planes</a></li>
          <li><a href="/portafolio">Portafolio</a></li>
          <li><a href="/proceso">Proceso</a></li>
          <li><a href="/contacto">Contacto</a></li>
        </ul>
      </nav>
      <WhatsAppLink class="cta-sm" telefono={contacto.whatsapp} mensaje={mensajes.general}>WhatsApp</WhatsAppLink>
    </header>

    <main id="contenido">
      <section class="sky" aria-labelledby="hero-t" data-sky>
        <div class="stars" aria-hidden="true" data-depth="0.15">
          {fondo.map((f) => <i style={`left:${f.x}%;top:${f.y}%;--r:${f.r}px`} />)}
        </div>
        <div class="tri" aria-hidden="true" data-tri>
          {triangulo.map((t) => (
            <span class="big-star" style={`left:${t.x}%;top:${t.y}%`} data-star data-name={t.id}><b>{t.id}</b></span>
          ))}
          <span class="lnk" data-line></span><span class="lnk" data-line></span><span class="lnk" data-line></span>
          <span class="lnk lnk--cur" data-cline></span>
        </div>
        <p class="readout" aria-hidden="true" data-readout>AR {estrella.ar} · DEC {estrella.dec}</p>

        <div class="wrap sky-txt">
          <p class="kicker" data-in>Altair Studio · páginas web para comercios en Bogotá</p>
          <h1 id="hero-t" class="h1" data-hero-title>Que lo<br />encuentren.</h1>
          <p class="lead" data-in>Una página clara, rápida y suya: su cliente lo busca en Google, ve qué vende y le escribe por WhatsApp.</p>
          <div class="ctas" data-in>
            <WhatsAppLink class="btn" telefono={contacto.whatsapp} mensaje={mensajes.general} data-magnetic>Escríbanos por WhatsApp →</WhatsAppLink>
            <a class="btn btn--line" href="/planes">Planes desde {cop(planes[0].precioLanzamiento!)}</a>
          </div>
        </div>
        <p class="hint" aria-hidden="true">Mueva el cursor por el cielo</p>
      </section>

      <section class="cards wrap" aria-label="Secciones del sitio">
        <a class="card" href="/planes" data-card>
          <div class="vis vis-plan" aria-hidden="true">
            {planes.map((p, i) => (
              <span class="pcard" style={`--i:${i}`} data-depth={String(0.3 + i * 0.3)}>
                <small>{p.nombre}</small><b>{cop(p.precioLanzamiento ?? p.precioOficial)}{p.desde ? '+' : ''}</b>
              </span>
            ))}
          </div>
          <div class="card-txt"><span class="num">01</span><h2>Planes</h2><p>Tres planes, con precio de lanzamiento.</p></div>
        </a>
        <a class="card" href="/portafolio" data-card>
          <div class="vis vis-port" aria-hidden="true">
            <span class="shot s1" data-depth="0.25"><Image src={arke} alt="" widths={[400, 700]} sizes="360px" /></span>
            <span class="shot s2" data-depth="0.6"><Image src={filo} alt="" widths={[240, 400]} sizes="140px" /></span>
            <span class="shot s3" data-depth="0.9"><Image src={lenera} alt="" widths={[240, 400]} sizes="140px" /></span>
          </div>
          <div class="card-txt"><span class="num">02</span><h2>Portafolio</h2><p>ARKE, Filo y La Leñera.</p></div>
        </a>
        <a class="card" href="/proceso" data-card>
          <div class="vis vis-proc" aria-hidden="true">
            {['Hablamos', 'Diseñamos', 'Revisa', 'Publica'].map((p, i) => <span class="step" style={`--i:${i}`} data-depth={String(0.2 + i * 0.25)}><i>{i + 1}</i>{p}</span>)}
          </div>
          <div class="card-txt"><span class="num">03</span><h2>Proceso</h2><p>De la primera llamada a publicar.</p></div>
        </a>
      </section>
    </main>

    <footer class="foot wrap">
      <Logo etiqueta="" />
      <p>{contacto.whatsapp} · {contacto.email}</p>
      <p><a href="/terminos">Términos</a> · <a href="/privacidad">Datos</a></p>
    </footer>
  </div>
</Lab>

<style>
  .c { font-family: 'Martian Mono', ui-monospace, monospace; font-stretch: 87.5%; font-size: 14px; }
  .c :global(.logo) { height: 20px; --logo-accent: var(--violet); }
  .hdr { position: absolute; left: 0; right: 0; top: 0; z-index: 10; display: flex; align-items: center; gap: 24px; height: 76px; }
  .hdr-logo { color: var(--fg); margin-right: auto; }
  .nav { display: none; gap: 28px; }
  .nav a { text-decoration: none; color: var(--fg-2); font-size: 12px; text-transform: uppercase; letter-spacing: .08em; padding-block: 12px; }
  .nav a:hover { color: var(--fg); }
  .cta-sm { display: inline-flex; align-items: center; height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--hair-2); text-decoration: none; font-size: 12px; text-transform: uppercase; letter-spacing: .08em; }
  .cta-sm:hover { border-color: var(--violet); }
  @media (min-width: 900px) { .nav { display: flex; } }

  .sky { position: relative; min-height: 100svh; overflow: hidden; display: flex; align-items: flex-end; padding-bottom: 72px; background: #05040a; }
  .stars { position: absolute; inset: -40px; }
  .stars i { position: absolute; width: var(--r); height: var(--r); border-radius: 50%; background: #cfd6ff; opacity: .55; }
  .tri { position: absolute; left: 0; right: 0; top: 70px; height: 34%; pointer-events: none; }
  @media (min-width: 900px) { .tri { top: 0; height: 100%; } }
  .big-star { position: absolute; width: 10px; height: 10px; margin: -5px 0 0 -5px; border-radius: 50%; background: #fff; box-shadow: 0 0 0 6px rgba(122,75,255,.18), 0 0 0 14px rgba(122,75,255,.07); }
  .big-star[data-name='Altair'] { background: var(--violet-ink); width: 14px; height: 14px; margin: -7px 0 0 -7px; }
  .big-star[data-name='Deneb'] b { left: auto; right: 18px; }
  .big-star b { position: absolute; left: 18px; top: -4px; font-size: 11px; font-weight: 500; color: var(--blue-ink); letter-spacing: .08em; text-transform: uppercase; white-space: nowrap; }
  .lnk { position: absolute; left: 0; top: 0; height: 1px; width: 1px; background: rgba(185,164,255,.55); transform-origin: 0 50%; }
  .lnk--cur { background: rgba(169,198,255,.7); opacity: 0; }
  .readout { position: absolute; display: none; right: var(--pad); top: 96px; font-size: 11px; color: var(--blue-ink); letter-spacing: .06em; }
  .sky-txt { position: relative; z-index: 2; }
  .kicker { font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: var(--fg-2); margin-bottom: 18px; }
  .h1 { font-family: 'Archivo', sans-serif; font-stretch: 125%; font-weight: 800; font-size: clamp(2.6rem, 0.6rem + 7.4vw, 7.25rem); line-height: .9; letter-spacing: -0.035em; text-transform: uppercase; }
  .lead { max-width: 44ch; margin-top: 24px; font-size: 15px; color: var(--fg-2); line-height: 1.6; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; }
  .btn { display: inline-flex; align-items: center; height: 54px; padding: 0 22px; border-radius: 999px; background: var(--violet); color: #fff; text-decoration: none; font-weight: 600; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; }
  .btn:hover { background: var(--violet-2); }
  .btn--line { background: transparent; border: 1px solid var(--hair-2); color: var(--fg); }
  .btn--line:hover { background: var(--s1); }
  .hint { position: absolute; right: var(--pad); bottom: 28px; font-size: 11px; color: var(--fg-3); text-transform: uppercase; letter-spacing: .1em; display: none; }
  @media (hover: hover) and (pointer: fine) { .hint, .readout { display: block; } }
  @media (max-width: 599px) { .h1 { font-stretch: 100%; } }

  .cards { display: grid; gap: 16px; padding-block: 72px 96px; }
  .card { position: relative; display: grid; grid-template-rows: 240px auto; overflow: hidden; border-radius: 28px; background: var(--s1); border: 1px solid var(--hair); text-decoration: none; will-change: transform; transition: border-color .3s; }
  .card:hover { border-color: rgba(122,75,255,.5); }
  .vis { position: relative; overflow: hidden; background: var(--s2); border-bottom: 1px solid var(--hair); }
  .card-txt { display: grid; grid-template-columns: auto 1fr; gap: 4px 16px; align-items: baseline; padding: 22px 24px 26px; }
  .num { grid-row: span 2; font-size: 12px; color: var(--violet-ink); }
  .card h2 { font-family: 'Archivo', sans-serif; font-stretch: 112%; font-weight: 700; font-size: 1.75rem; letter-spacing: -0.02em; text-transform: uppercase; }
  .card p { color: var(--fg-2); font-size: 13px; }

  .vis-plan { display: grid; place-items: center; }
  .pcard { position: absolute; display: grid; gap: 4px; width: 50%; padding: 16px 18px; border-radius: 16px; background: var(--s3); border: 1px solid var(--hair-2); box-shadow: 0 18px 30px -16px rgba(0,0,0,.8); transform: translate(calc((var(--i) - 1) * 34%), calc((var(--i) - 1) * 62px)) rotate(calc((var(--i) - 1) * 4deg)); }
  .pcard:nth-child(2) { background: var(--violet); border-color: transparent; z-index: 2; }
  .pcard small { font-size: 11px; color: var(--fg-2); text-transform: uppercase; letter-spacing: .06em; }
  .pcard:nth-child(2) small { color: rgba(255,255,255,.85); }
  .pcard b { font-family: 'Archivo', sans-serif; font-stretch: 112%; font-size: 1.5rem; }

  .vis-port .shot { position: absolute; overflow: hidden; border-radius: 12px; border: 1px solid var(--hair-2); box-shadow: 0 20px 40px -18px rgba(0,0,0,.9); }
  .vis-port :global(img) { width: 100%; height: auto; }
  .s1 { left: 8%; top: 14%; width: 78%; }
  .s2 { right: 6%; top: 34%; width: 26%; }
  .s3 { left: 4%; top: 46%; width: 24%; }

  .vis-proc { display: grid; align-content: center; gap: 8px; padding: 24px; }
  .step { display: flex; align-items: center; gap: 12px; width: max-content; padding: 10px 16px 10px 10px; border-radius: 999px; background: var(--s3); border: 1px solid var(--hair-2); font-size: 12px; margin-left: calc(var(--i) * 12%); }
  .step i { display: grid; place-items: center; width: 26px; height: 26px; border-radius: 50%; background: var(--blue); color: #06122e; font-style: normal; font-weight: 700; }

  @media (min-width: 900px) {
    .cards { grid-template-columns: repeat(3, 1fr); }
    .card { grid-template-rows: 280px auto; }
  }
  .foot { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px; padding-block: 28px; border-top: 1px solid var(--hair); color: var(--fg-3); font-size: 12px; }
  .foot a { color: var(--fg-2); }
</style>

<script>
  import { initMotion } from '@altair/core/motion';
  import { revealText } from '@altair/core/reveal';
  import { magnetic, tilt, parallaxPointer, finePointer } from '@altair/core/pointer';

  const m = initMotion();
  const { gsap } = m;
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => [...r.querySelectorAll<T>(s)];

  $$('[data-magnetic]').forEach((el) => magnetic(m, el, 0.25));
  $$('[data-card]').forEach((el) => tilt(m, el, 5));

  const sky = document.querySelector<HTMLElement>('[data-sky]')!;
  const tri = document.querySelector<HTMLElement>('[data-tri]')!;
  const stars = $$('[data-star]');
  const lines = $$('[data-line]');
  const cline = document.querySelector<HTMLElement>('[data-cline]')!;
  const readout = document.querySelector<HTMLElement>('[data-readout]')!;
  const altairTxt = `Altair · ${readout.textContent}`;
  parallaxPointer(m, sky);

  /** Línea de A a B usando solo transform (rotación + escala horizontal). */
  const unir = (el: HTMLElement, a: { x: number; y: number }, b: { x: number; y: number }) => {
    const dx = b.x - a.x, dy = b.y - a.y;
    gsap.set(el, { x: a.x, y: a.y, rotation: (Math.atan2(dy, dx) * 180) / Math.PI, scaleX: Math.hypot(dx, dy) });
  };
  const centro = (el: HTMLElement) => {
    const r = el.getBoundingClientRect(), s = tri.getBoundingClientRect();
    return { x: r.left + r.width / 2 - s.left, y: r.top + r.height / 2 - s.top };
  };
  const dibujar = () => {
    const p = stars.map(centro);
    unir(lines[0], p[0], p[1]); unir(lines[1], p[1], p[2]); unir(lines[2], p[2], p[0]);
  };
  dibujar();
  window.addEventListener('resize', dibujar);

  if (!m.reduced) {
    // El triángulo se dibuja al entrar.
    gsap.from(lines, { scaleX: 0, duration: 1.2, stagger: 0.25, ease: 'power3.inOut', delay: 0.6, onComplete: dibujar });
    gsap.from(stars, { scale: 0, duration: 0.6, stagger: 0.2, ease: 'back.out(2)', delay: 0.3 });
    gsap.from('.stars i', { opacity: 0, duration: 1.5, stagger: { each: 0.015, from: 'random' } });
    const t = document.querySelector('[data-hero-title]');
    if (t) revealText(m, t, { tipo: 'chars', scroll: false, delay: 0.4, stagger: 0.035 });
    gsap.to('[data-in]', { opacity: 1, duration: 0.8, stagger: 0.12, delay: 0.9 });
    gsap.from('[data-card]', { y: 60, opacity: 0, duration: 0.9, stagger: 0.12, ease: 'power3.out', scrollTrigger: { trigger: '.cards', start: 'top 85%', once: true } });

    if (finePointer()) {
      // El cursor se une a la estrella más cercana; la estrella crece y la lectura de coordenadas sigue al cursor.
      const op = gsap.quickTo(cline, 'opacity', { duration: 0.3 });
      sky.addEventListener('pointermove', (e) => {
        const s = tri.getBoundingClientRect();
        const c = { x: e.clientX - s.left, y: e.clientY - s.top };
        const p = stars.map(centro);
        let k = 0, d = Infinity;
        p.forEach((q, i) => { const dd = Math.hypot(q.x - c.x, q.y - c.y); if (dd < d) { d = dd; k = i; } });
        unir(cline, p[k], c);
        op(d < 420 ? 1 - d / 420 : 0);
        stars.forEach((st, i) => gsap.to(st, { scale: i === k ? 1 + Math.max(0, 1 - d / 300) : 1, duration: 0.3, overwrite: 'auto' }));
        // Solo datos reales: las coordenadas de Altair; para Vega y Deneb, el nombre.
        readout.textContent = k === 0 ? altairTxt : `${stars[k].dataset.name} · Triángulo de verano`;
      });
      sky.addEventListener('pointerleave', () => { op(0); stars.forEach((st) => gsap.to(st, { scale: 1, duration: 0.4 })); });
    }
  } else {
    gsap.set('[data-in]', { opacity: 1 });
  }
</script>
