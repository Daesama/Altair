---
import Base from '../layouts/Base.astro';
import { navegacion } from '../nav';
---
<Base titulo="Página no encontrada — Altair Studio" descripcion="Esta dirección no existe en altair.lat." noindex>
  <section class="page wrap nf">
    <span class="tag">Error 404</span>
    <h1 class="h1">Esta página no existe.</h1>
    <p class="lead">Revise la dirección o siga por aquí:</p>
    <ul class="nf-links">
      {navegacion.map((n) => <li><a class="btn btn--ghost" href={n.href}>{n.nombre}</a></li>)}
    </ul>
  </section>
</Base>
<style>
  .nf { display: grid; gap: 20px; justify-items: start; align-content: center; min-height: 60vh; }
  .nf-links { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
</style>
