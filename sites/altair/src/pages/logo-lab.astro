---
/**
 * Página temporal para elegir el logo. No se indexa ni aparece en el sitemap.
 * Al elegir un concepto, se copia su archivo a src/brand/logo.svg y esta página se borra.
 */
import Base from '../layouts/Base.astro';
import a from '../brand/concepts/a-alineacion.svg?raw';
import b from '../brand/concepts/b-triangulo.svg?raw';
import c from '../brand/concepts/c-rotacion.svg?raw';

const limpiar = (s: string) => s.replace(/<!--[\s\S]*?-->/g, '').trim();
const simbolo = (s: string) => {
  const caja = s.match(/data-symbol="([^"]+)"/)?.[1];
  return caja ? s.replace(/viewBox="[^"]+"/, `viewBox="${caja}"`).replace(/<g class="wordmark"[\s\S]*?<\/g>/, '') : s;
};

const conceptos = [
  {
    id: 'A',
    nombre: 'Alineación',
    svg: limpiar(a),
    idea: 'Altair tiene dos estrellas a los lados, Tarazed (γ) y Alshain (β), y las tres quedan casi en línea recta. Así la reconocen quienes observan el cielo. El símbolo usa esas posiciones reales: Altair es el cuadro grande y violeta, y las otras dos son cuadros más pequeños, del tamaño que les corresponde por su brillo.',
    porque: 'Funciona como señal: un punto fuerte entre dos acompañantes, igual que un negocio al que encuentran entre los demás. A tamaño de favicon queda el cuadro violeta, que es fácil de reconocer.',
  },
  {
    id: 'B',
    nombre: 'Triángulo de verano',
    svg: limpiar(b),
    idea: 'Altair, Vega y Deneb forman el Triángulo de Verano, uno de los dibujos más fáciles de ver en el cielo. El triángulo mantiene sus proporciones reales y está girado para que Altair quede arriba. Así se convierte en la A del logotipo: se lee ∆LTAIR.',
    porque: 'El símbolo y la palabra son una sola pieza. Es el concepto más «de marca», porque la A sirve sola como ícono, pero también el que pide más espacio horizontal para leerse bien.',
  },
  {
    id: 'C',
    nombre: 'Rotación',
    svg: limpiar(c),
    idea: 'Altair gira tan rápido (una vuelta cada 7,77 horas) que se achata: su ecuador mide 1,28 veces su eje polar. El símbolo es una elipse con esa proporción exacta, partida por su eje de rotación, con dos marcas en el ecuador.',
    porque: 'Es el más técnico y el menos literal: no parece una estrella, sino un dato de la estrella convertido en forma. Se ve bien en violeta sólido y a cualquier tamaño.',
  },
];
---
<Base titulo="Logo lab — Altair Studio" descripcion="Página temporal de conceptos de logo." noindex>
  <section class="sec lab">
    <div class="wrap">
      <div class="sec-head label">
        <span class="sec-num"><b>Logo lab</b> · temporal</span>
        <span>3 conceptos · elija uno</span>
      </div>
      <h1 class="display lab-h">Tres conceptos de logo, todos dibujados con datos reales de Altair.</h1>
      <p class="lab-p">
        El logotipo «ALTAIR» se dibujó a mano, con trazos geométricos (no es una fuente) y el mismo grosor en todas las letras. Cada
        concepto tiene un símbolo propio. Abajo se ve cada uno en grande, en el encabezado, como favicon y sobre fondo claro.
      </p>

      <ol class="lab-list">
        {conceptos.map((k) => (
          <li class="lab-item">
            <header class="lab-item-h">
              <span class="label">Concepto {k.id}</span>
              <h2 class="display lab-name">{k.nombre}</h2>
            </header>
            <div class="lab-big" set:html={k.svg} />
            <div class="lab-row">
              <figure class="lab-cell">
                <div class="lab-hdr" set:html={k.svg} />
                <figcaption class="label">Encabezado · 18 px</figcaption>
              </figure>
              <figure class="lab-cell">
                <div class="lab-favs">
                  <span class="fav fav-64" set:html={simbolo(k.svg)} />
                  <span class="fav fav-32" set:html={simbolo(k.svg)} />
                  <span class="fav fav-16" set:html={simbolo(k.svg)} />
                </div>
                <figcaption class="label">Favicon · 64 / 32 / 16 px</figcaption>
              </figure>
              <figure class="lab-cell lab-light">
                <div class="lab-hdr" set:html={k.svg} />
                <figcaption class="label">Sobre fondo claro</figcaption>
              </figure>
            </div>
            <div class="lab-text">
              <p><strong>La idea.</strong> {k.idea}</p>
              <p><strong>Por qué funciona.</strong> {k.porque}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>
</Base>

<style>
  .lab { padding-bottom: 80px; }
  .lab-h { font-size: clamp(1.75rem, 0.9rem + 3.4vw, 4rem); max-width: 20ch; margin: 40px 0 20px; }
  .lab-p { max-width: 60ch; font-size: var(--t-base); margin-bottom: 48px; }
  .lab-list { display: grid; gap: 0; border-top: 1px solid var(--line); }
  .lab-item { display: grid; gap: 28px; padding: 40px 0 56px; border-bottom: 1px solid var(--line); }
  .lab-name { font-size: clamp(1.75rem, 1rem + 2.4vw, 3rem); margin-top: 6px; }
  .lab-big { padding: clamp(28px, 6vw, 80px); background: var(--bg-2); border: 1px solid var(--line-2); color: var(--fg); --logo-accent: var(--violet); }
  .lab-big :global(svg) { width: 100%; height: auto; max-height: 180px; }
  .lab-row { display: grid; gap: 12px; grid-template-columns: 1fr; }
  .lab-cell { display: grid; gap: 12px; padding: 20px; border: 1px solid var(--line-2); align-content: space-between; min-height: 140px; }
  .lab-hdr { color: var(--fg); }
  .lab-hdr :global(svg) { height: 18px; width: auto; }
  .lab-light { background: var(--fg); }
  .lab-light .lab-hdr { color: var(--bg); }
  .lab-light .label { color: #4a4558; }
  .lab-favs { display: flex; align-items: end; gap: 16px; }
  .fav { display: grid; place-items: center; background: #07060a; border: 1px solid var(--line-2); color: var(--fg); }
  .fav :global(svg) { width: 76%; height: 76%; }
  .fav-64 { width: 64px; height: 64px; }
  .fav-32 { width: 32px; height: 32px; }
  .fav-16 { width: 16px; height: 16px; border: 0; }
  .lab-text { display: grid; gap: 14px; max-width: 68ch; font-size: var(--t-base); }
  .lab-text strong { color: var(--violet-ink); font-weight: 600; }
  /* Color de acento dentro de los SVG en línea */
  .lab-item :global(.accent) { fill: var(--violet); }
  @media (min-width: 768px) {
    .lab-row { grid-template-columns: repeat(3, 1fr); }
  }
</style>
