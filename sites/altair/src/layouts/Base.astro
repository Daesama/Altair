---
import { ClientRouter } from 'astro:transitions';
import Seo from '@altair/core/Seo.astro';
import Consent from '@altair/core/Consent.astro';
import { seo, marca } from '../../site.config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';
import geistUrl from '../assets/fonts/geist-latin-wght-normal.woff2?url';
import geistMonoUrl from '../assets/fonts/geist-mono-latin-wght-normal.woff2?url';

interface Props {
  titulo?: string;
  descripcion?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  /** Nombre del script de página en src/scripts/paginas (data-page). */
  pagina?: string;
}

const { titulo = seo.titulo, descripcion = seo.descripcion, noindex = false, jsonLd, pagina } = Astro.props;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        var t;
        // El enrutador reemplaza los atributos de <html> en cada cambio de página: se vuelven a poner.
        function marcar() {
          d.classList.add('js');
          if (matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('rm');
          clearTimeout(t);
          t = setTimeout(function () { d.classList.add('motion-fallback'); }, 3000);
        }
        marcar();
        document.addEventListener('astro:after-swap', marcar);
      })();
    </script>
    <link rel="preload" href={geistUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo
      titulo={titulo}
      descripcion={descripcion}
      sitio={seo.url}
      ogImage={seo.ogImage}
      nombreSitio={marca.nombre}
      locale={seo.locale}
      noindex={noindex}
      themeColor="#07060a"
      jsonLd={jsonLd}
    />
    <ClientRouter fallback="swap" />
  </head>
  <body class="grain">
    <a class="skip" href="#contenido">Saltar al contenido</a>
    <Header />
    <main id="contenido" data-page={pagina}>
      <slot />
    </main>
    <Footer />
    <div transition:persist="aviso">
    <Consent class="consent" aceptarClass="consent-ok" etiquetaAceptar="Entendido">
      <p>
        Sin cookies de rastreo. Si nos escribe, usamos sus datos según la
        <a href="/privacidad">política de datos</a>.
      </p>
    </Consent>
    </div>
    <script>
      import '../scripts/app';
    </script>
  </body>
</html>

<style is:global>
  .consent {
    position: fixed; z-index: 60; left: var(--pad); right: var(--pad); bottom: 16px; max-width: 480px;
    display: flex; gap: 16px; align-items: center; justify-content: space-between;
    padding: 12px 12px 12px 18px; border-radius: var(--r-md);
    background: var(--s2); border: 1px solid var(--hair-2); box-shadow: 0 24px 48px -24px #000;
    font-size: 13px; line-height: 1.5; color: var(--fg-2);
    transform: translateY(16px); opacity: 0;
    transition: transform 0.5s var(--ease-out), opacity 0.5s var(--ease-out);
  }
  .consent[data-open] { transform: none; opacity: 1; }
  .consent a { color: var(--fg); }
  .consent-ok { flex: none; min-height: 44px; padding: 0 16px; border-radius: 12px; background: var(--s3); border: 1px solid var(--hair-2); font-size: 13px; font-weight: 600; }
  .consent-ok:hover { background: var(--violet); border-color: var(--violet); }
</style>
