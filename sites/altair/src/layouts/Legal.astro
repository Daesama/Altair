---
import Base from './Base.astro';

interface Props {
  titulo: string;
  descripcion: string;
  actualizado: string;
}
const { titulo, descripcion, actualizado } = Astro.props;
---
<Base titulo={`${titulo} — Altair Studio`} descripcion={descripcion}>
  <article class="page wrap legal">
    <header class="legal-head">
      <span class="tag">Legal · actualizado el {actualizado}</span>
      <h1 class="h1 legal-h">{titulo}</h1>
      <p class="legal-draft mono">Borrador · sujeto a revisión jurídica</p>
    </header>
    <div class="legal-body">
      <slot />
    </div>
  </article>
</Base>

<style>
  .legal { display: grid; gap: 40px; }
  .legal-head { display: grid; gap: 16px; align-content: start; justify-items: start; }
  .legal-h { font-size: clamp(2rem, 1.3rem + 3vw, 3.5rem); max-width: 16ch; }
  .legal-draft { font-size: 12px; color: var(--violet-ink); }
  .legal-body { max-width: 72ch; font-size: 16px; line-height: 1.7; color: var(--fg-2); }
  .legal-body :global(h2) { margin: 40px 0 12px; padding-top: 20px; border-top: 1px solid var(--hair); font-size: 1.25rem; font-weight: 600; letter-spacing: -0.02em; color: var(--fg); }
  .legal-body :global(h2:first-child) { margin-top: 0; }
  .legal-body :global(p), .legal-body :global(ul), .legal-body :global(ol) { margin-bottom: 14px; }
  .legal-body :global(ul li) { position: relative; padding-left: 20px; margin-bottom: 6px; }
  .legal-body :global(ul li)::before { content: ''; position: absolute; left: 2px; top: 0.7em; width: 6px; height: 6px; border-radius: 50%; background: var(--violet); }
  .legal-body :global(ol) { counter-reset: n; }
  .legal-body :global(ol li) { counter-increment: n; position: relative; padding-left: 36px; margin-bottom: 6px; }
  .legal-body :global(ol li)::before { content: counter(n, decimal-leading-zero); position: absolute; left: 0; top: 3px; font: 500 12px var(--f-mono); color: var(--blue-ink); }
  .legal-body :global(strong) { font-weight: 600; color: var(--fg); }
  .legal-body :global(a) { color: var(--violet-ink); }
  @media (min-width: 1024px) {
    .legal { grid-template-columns: 4fr 7fr; gap: 64px; }
    .legal-head { position: sticky; top: calc(var(--header-h) + 32px); align-self: start; }
  }
</style>
