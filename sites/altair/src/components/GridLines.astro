---
/** Líneas de columna fijas: la grilla del sitio, visible como elemento de diseño. */
---
<div class="gridlines" aria-hidden="true">
  <div class="wrap grid">
    {Array.from({ length: 12 }, () => <span data-gridline />)}
  </div>
</div>

<style>
  .gridlines {
    position: fixed; inset: 0; z-index: -1; pointer-events: none;
  }
  .gridlines .grid { height: 100%; }
  span {
    height: 100%;
    border-left: 1px solid var(--line);
    transform-origin: top;
  }
  span:nth-child(n + 5) { display: none; }
  span:nth-child(4) { border-right: 1px solid var(--line); }
  @media (min-width: 768px) {
    span:nth-child(n + 5) { display: block; }
    span:nth-child(n + 9) { display: none; }
    span:nth-child(4) { border-right: 0; }
    span:nth-child(8) { border-right: 1px solid var(--line); }
  }
  @media (min-width: 1200px) {
    span:nth-child(n + 9) { display: block; }
    span:nth-child(8) { border-right: 0; }
    span:nth-child(12) { border-right: 1px solid var(--line); }
  }
</style>
