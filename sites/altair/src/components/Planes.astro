---
import WhatsAppLink from '@altair/core/WhatsAppLink.astro';
import { cop } from '@altair/core/types';
import { contacto, costosTerceros, lanzamiento, mensajes, mensualidadCubre, planes } from '../../site.config';

const ocupados = lanzamiento.cuposTotales - lanzamiento.cuposRestantes;
---
<section id="planes" class="sec planes" aria-labelledby="planes-t">
  <div class="wrap">
    <div class="sec-head label">
      <span class="sec-num"><b>02</b> / 04</span>
      <span>Planes y precios · COP</span>
    </div>

    <div class="grid planes-intro">
      <h2 id="planes-t" class="display planes-h" data-reveal="lines">Tres planes. Usted elige hasta dónde llega su página.</h2>
      <div class="cupos" data-cupos>
        <p class="label">Precio de lanzamiento</p>
        <p class="cupos-n">
          Quedan <strong data-count={lanzamiento.cuposRestantes}>{lanzamiento.cuposRestantes}</strong> de {lanzamiento.cuposTotales} cupos
        </p>
        <ol class="cupos-bar" aria-hidden="true">
          {Array.from({ length: lanzamiento.cuposTotales }, (_, i) => <li class={i < ocupados ? 'is-taken' : ''} data-cupo />)}
        </ol>
        <p class="cupos-note">Aplica a los planes Esencial y Negocio. Cuando se acaben, rige el precio oficial.</p>
      </div>
    </div>

    <div class="plans">
      {planes.map((p, i) => (
        <article class={`plan plan--${p.id}`} aria-labelledby={`plan-${p.id}`} data-plan>
          <header class="plan-id">
            <span class="label">P/{String(i + 1).padStart(2, '0')} · {p.tipo}</span>
            <h3 id={`plan-${p.id}`} class="display plan-name">{p.nombre}</h3>
            <p class="plan-sum">{p.resumen}</p>
          </header>

          <ul class="plan-inc" aria-label={`Incluye el plan ${p.nombre}`}>
            {p.incluye.map((x) => <li>{x}</li>)}
          </ul>

          <div class="plan-price">
            {p.precioLanzamiento ? (
              <>
                <p class="price-old">
                  <span class="sr-only">Precio oficial: </span>
                  <s>{cop(p.precioOficial)}</s>
                </p>
                <p class="price-now">
                  <span class="sr-only">Precio de lanzamiento: </span>
                  <span data-price-from={p.precioOficial} data-price-to={p.precioLanzamiento}>{cop(p.precioLanzamiento)}</span>
                </p>
                <p class="label">Lanzamiento · quedan {lanzamiento.cuposRestantes} cupos</p>
              </>
            ) : (
              <>
                <p class="price-now">
                  {p.desde && <span class="price-desde">Desde</span>}
                  {cop(p.precioOficial)}
                </p>
                <p class="label">{p.mensualidad.nota}</p>
              </>
            )}

            <dl class="plan-month">
              <dt class="label">Mensualidad</dt>
              <dd>
                {p.mensualidad.oficial === null ? (
                  <span>Sin mensualidad · pago único</span>
                ) : p.mensualidad.lanzamiento ? (
                  <>
                    <s class="price-old-inline">{cop(p.mensualidad.oficial)}</s>{' '}
                    <strong>{cop(p.mensualidad.lanzamiento)}/mes</strong>
                    <span class="month-note">{p.mensualidad.nota}</span>
                  </>
                ) : (
                  <strong>{cop(p.mensualidad.oficial)}/mes</strong>
                )}
              </dd>
            </dl>

            <WhatsAppLink class={`btn ${p.id === 'total' ? 'btn--dark' : ''}`} telefono={contacto.whatsapp} mensaje={mensajes.plan(p.nombre)}>
              Quiero el plan {p.nombre} <span class="arrow" aria-hidden="true">→</span>
            </WhatsAppLink>
          </div>
        </article>
      ))}
    </div>

    <div class="grid month">
      <div class="month-cover">
        <h3 class="label month-t">Qué cubre la mensualidad</h3>
        <p class="month-sub">Planes Negocio y Total. Su página sigue funcionando y alguien responde cuando algo falla.</p>
        <ol class="month-list">
          {mensualidadCubre.map((x, i) => (
            <li><span class="data">{String(i + 1).padStart(2, '0')}</span>{x}</li>
          ))}
        </ol>
      </div>
      <div class="month-third">
        <h3 class="label month-t">Costos de terceros</h3>
        <p>{costosTerceros}</p>
      </div>
    </div>
  </div>
</section>

<style>
  .planes { padding-bottom: 72px; }
  .planes-intro { padding-block: 40px 48px; row-gap: 32px; }
  .planes-h { grid-column: 1 / -1; font-size: clamp(1.75rem, 0.9rem + 3.4vw, 4.25rem); max-width: 18ch; }

  .cupos { grid-column: 1 / -1; display: grid; gap: 10px; align-content: end; }
  .cupos-n { font-size: var(--t-lg); }
  .cupos-n strong { color: var(--violet-ink); font-weight: 600; }
  .cupos-bar { display: grid; grid-template-columns: repeat(10, 1fr); gap: 4px; height: 14px; }
  .cupos-bar li { background: var(--violet); transform-origin: left; }
  .cupos-bar li.is-taken { background: transparent; border: 1px solid var(--line-2); }
  .cupos-note { font-size: var(--t-xs); color: var(--mute); }

  .plans { border-top: 1px solid var(--line); }
  .plan {
    display: grid; gap: 24px;
    padding-block: 28px 32px;
    border-bottom: 1px solid var(--line);
    background: var(--bg);
  }
  .plan-id { display: grid; gap: 10px; align-content: start; }
  .plan-name { font-size: clamp(2.25rem, 1.4rem + 2.6vw, 3.75rem); font-stretch: 112%; }
  .plan-sum { max-width: 36ch; color: var(--fg); }

  .plan-inc { display: grid; gap: 0; align-content: start; }
  .plan-inc li {
    position: relative; padding: 9px 0 9px 22px;
    border-bottom: 1px solid var(--line);
  }
  .plan-inc li::before { content: '+'; position: absolute; left: 0; color: var(--violet-ink); }
  .plan-inc li:first-child { border-top: 1px solid var(--line); }

  .plan-price { display: grid; gap: 8px; align-content: start; }
  .price-old { color: var(--mute); font-size: var(--t-base); }
  .price-old s { text-decoration-thickness: 2px; text-decoration-color: var(--violet); }
  .price-now {
    font-family: var(--f-display); font-stretch: 125%; font-weight: 800;
    font-size: clamp(2.25rem, 1.6rem + 2.6vw, 3.5rem); line-height: 1; letter-spacing: -0.02em;
    font-variant-numeric: tabular-nums;
  }
  .price-desde { display: block; font-family: var(--f-mono); font-size: var(--t-xs); font-weight: 500; letter-spacing: 0.06em; text-transform: uppercase; margin-bottom: 6px; }
  .plan-month { margin: 12px 0 16px; padding-top: 12px; border-top: 1px solid var(--line); display: grid; gap: 4px; }
  .plan-month dd { display: flex; flex-wrap: wrap; gap: 4px 10px; align-items: baseline; }
  .plan-month strong { font-weight: 600; }
  .price-old-inline { color: var(--mute); text-decoration-color: var(--violet); }
  .month-note { flex-basis: 100%; font-size: var(--t-xs); color: var(--mute); }
  .plan .btn { justify-content: space-between; }

  /* Pesos visuales distintos por plan */
  .plan--negocio { position: relative; }
  .plan--negocio::before {
    content: ''; position: absolute; left: calc(var(--gutter) * -1); top: -1px; bottom: -1px; width: 4px;
    background: var(--violet);
  }
  .plan--total {
    --mute: #4a4558;
    background: var(--fg); color: var(--bg);
    margin-inline: calc(var(--gutter) * -1);
    padding-inline: var(--gutter);
    border-bottom: 0;
  }
  .plan--total .label { color: #4a4558; }
  .plan--total .plan-sum { color: var(--bg); }
  .plan--total .plan-inc li, .plan--total .plan-inc li:first-child, .plan--total .plan-month { border-color: #c9c4d6; }
  .plan--total .plan-inc li::before { color: var(--violet); }
  .btn--dark { --b-bg: var(--bg); --b-fg: var(--fg); }
  .plan--total .btn::before { background: var(--violet); }
  .plan--total .btn:hover, .plan--total .btn:focus-visible { color: #fff; }

  .month { padding-top: 48px; row-gap: 40px; }
  .month-cover, .month-third { grid-column: 1 / -1; display: grid; gap: 14px; align-content: start; }
  .month-t { color: var(--violet-ink); }
  .month-sub { font-size: var(--t-lg); max-width: 34ch; }
  .month-list { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--line); }
  .month-list li { display: flex; gap: 14px; padding: 10px 0; border-bottom: 1px solid var(--line); }
  .month-third p { max-width: 42ch; color: var(--fg); }

  @media (min-width: 768px) {
    .planes { padding-bottom: 112px; }
    .planes-intro { padding-block: 56px 64px; }
    .planes-h { grid-column: 1 / span 5; }
    .cupos { grid-column: 6 / -1; }
    .plan { grid-template-columns: repeat(8, minmax(0, 1fr)); column-gap: var(--gutter); padding-block: 40px 44px; }
    .plan-id { grid-column: 1 / span 4; }
    .plan-inc { grid-column: 5 / -1; grid-row: 1 / span 2; }
    .plan-price { grid-column: 1 / span 4; }
    .month-list { grid-template-columns: 1fr 1fr; column-gap: var(--gutter); }
    .month-cover { grid-column: 1 / span 5; }
    .month-third { grid-column: 6 / -1; }
  }
  @media (min-width: 1200px) {
    .planes-h { grid-column: 1 / span 7; }
    .cupos { grid-column: 9 / -1; }
    .plan { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .plan-id { grid-column: 1 / span 4; position: sticky; top: calc(var(--header-h) + 24px); }
    .plan-inc { grid-column: 5 / span 4; grid-row: auto; }
    .plan-price { grid-column: 9 / -1; }
    .month-cover { grid-column: 1 / span 7; }
    .month-third { grid-column: 9 / -1; }
  }
</style>
