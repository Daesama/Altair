---
import WhatsAppLink from '@altair/core/WhatsAppLink.astro';
import { igLink, mailLink } from '@altair/core/whatsapp';
import Logo from '../brand/Logo.astro';
import { contacto, estrella, marca, mensajes } from '../../site.config';

const anio = new Date().getFullYear();
---
<footer id="contacto" class="sec foot" aria-labelledby="foot-t">
  <div class="wrap">
    <div class="sec-head label">
      <span class="sec-num"><b>04</b> / 04</span>
      <span>Contacto</span>
    </div>

    <div class="grid foot-main">
      <h2 id="foot-t" class="display foot-h" data-reveal="lines">Cuéntenos qué vende. Le respondemos por WhatsApp.</h2>
      <WhatsAppLink class="foot-wa" telefono={contacto.whatsapp} mensaje={mensajes.general}>
        <span class="label">WhatsApp</span>
        <span class="foot-wa-n">{contacto.whatsapp}</span>
        <span class="arrow" aria-hidden="true">→</span>
      </WhatsAppLink>
    </div>

    <dl class="foot-cells">
      <div>
        <dt class="label">Correo</dt>
        <dd><a class="link" href={mailLink(contacto.email, 'Página web para mi negocio')}>{contacto.email}</a></dd>
      </div>
      <div>
        <dt class="label">Instagram</dt>
        <dd><a class="link" href={igLink(contacto.instagram)} target="_blank" rel="noopener">{contacto.instagram}</a></dd>
      </div>
      <div>
        <dt class="label">Ciudad</dt>
        <dd>{contacto.ciudad}</dd>
      </div>
      <div>
        <dt class="label">Legal</dt>
        <dd class="foot-legal">
          <a class="link" href="/terminos">Términos y condiciones</a>
          <a class="link" href="/privacidad">Tratamiento de datos</a>
        </dd>
      </div>
    </dl>

    <div class="foot-bottom">
      <a href="/" class="foot-logo" aria-label="Altair Studio, ir al inicio"><Logo etiqueta="" /></a>
      <p class="label">© {anio} {marca.nombre} · {contacto.ciudad}</p>
      <p class="label foot-star">
        <span class="data nocaps">{estrella.designacion}</span> {estrella.ar} {estrella.dec} · mag {estrella.magnitud} · {estrella.distanciaAl} años luz
      </p>
    </div>
  </div>
</footer>

<style>
  .foot { padding-bottom: 24px; }
  .foot-main { padding-block: 40px 48px; row-gap: 32px; }
  .foot-h { grid-column: 1 / -1; font-size: clamp(1.75rem, 0.9rem + 3.4vw, 4.25rem); max-width: 18ch; }
  .foot-wa {
    grid-column: 1 / -1;
    display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 8px 16px;
    padding: 20px; background: var(--violet); color: #fff; text-decoration: none;
    transition: background-color 0.3s;
  }
  .foot-wa .label { grid-column: 1 / -1; color: #fff; }
  .foot-wa-n {
    font-family: var(--f-display); font-stretch: 112%; font-weight: 700;
    font-size: clamp(1.375rem, 0.9rem + 2.6vw, 3rem); line-height: 1; white-space: nowrap;
  }
  .foot-wa .arrow { display: inline-block; font-size: 1.75rem; line-height: 1; transition: transform 0.45s var(--ease-out); }
  .foot-wa:hover { background: #6236f0; }
  .foot-wa:hover .arrow, .foot-wa:focus-visible .arrow { transform: translateX(8px); }

  .foot-cells { display: grid; grid-template-columns: 1fr; border-top: 1px solid var(--line); }
  .foot-cells > div { display: grid; gap: 6px; padding: 18px 0; border-bottom: 1px solid var(--line); }
  .foot-cells dd { font-size: var(--t-base); overflow-wrap: anywhere; }
  .foot-legal { display: grid; gap: 6px; justify-items: start; }

  .foot-bottom { display: grid; gap: 12px; padding-top: 32px; }
  .foot-logo { font-size: 22px; color: var(--fg); --logo-accent: var(--violet); justify-self: start; }

  @media (min-width: 768px) {
    .foot-main { padding-block: 56px 64px; }
    .foot-h { grid-column: 1 / span 5; }
    .foot-wa { grid-column: 6 / -1; align-self: end; padding: 24px; }
    .foot-cells { grid-template-columns: repeat(4, 1fr); }
    .foot-cells > div { padding: 20px 16px 24px; border-bottom: 0; border-right: 1px solid var(--line); }
    .foot-cells > div:first-child { padding-left: 0; }
    .foot-cells > div:last-child { border-right: 0; }
    .foot-bottom { grid-template-columns: auto 1fr auto; align-items: center; gap: 24px; border-top: 1px solid var(--line); padding-top: 20px; }
  }
  @media (min-width: 1200px) {
    .foot-h { grid-column: 1 / span 7; }
    .foot-wa { grid-column: 8 / -1; }
  }
</style>
