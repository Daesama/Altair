---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { portafolio } from '../../site.config';

const capturas = import.meta.glob<{ default: ImageMetadata }>('../assets/portfolio/*.{png,jpg,webp}', { eager: true });
const captura = (archivo: string) =>
  Object.entries(capturas).find(([ruta]) => ruta.endsWith('/' + archivo))?.[1].default;
const dominio = (url: string) => new URL(url).hostname;
---
<section id="portafolio" class="sec portafolio" aria-labelledby="port-t">
  <div class="wrap">
    <div class="sec-head label">
      <span class="sec-num"><b>03</b> / 04</span>
      <span>Portafolio · {portafolio.length} casos</span>
    </div>

    <div class="grid port-intro">
      <h2 id="port-t" class="display port-h" data-reveal="lines">Páginas que ya están en internet.</h2>
      <p class="port-lead">
        Un caso real y dos demostraciones. Las demos son negocios inventados: muestran exactamente lo que recibe con el plan Esencial.
      </p>
    </div>

    <ol class="cases">
      {portafolio.map((c, i) => {
        const img = captura(c.captura);
        return (
          <li class={`case case--${i}`} data-case>
            <a class="case-link" href={c.url} target="_blank" rel="noopener">
              <figure class="case-fig">
                <div class="case-frame">
                  <div class="case-bar label" aria-hidden="true">
                    <span class="dot" /><span>{dominio(c.url)}</span>
                  </div>
                  <div class="case-img">
                    {img ? (
                      <Image
                        src={img}
                        alt={`Captura de la página de inicio de ${c.nombre}`}
                        widths={[480, 800, 1200]}
                        sizes="(min-width: 1200px) 66vw, 100vw"
                        format="webp"
                        quality={72}
                        data-parallax
                      />
                    ) : (
                      <div class="case-missing label">Captura pendiente</div>
                    )}
                  </div>
                </div>
              </figure>
              <div class="case-meta">
                <span class="label">C/{String(i + 1).padStart(2, '0')} · {c.real ? 'Caso real' : 'Demostración'}</span>
                <h3 class="display case-name">{c.nombre}</h3>
                <p class="case-type data">{c.tipo}</p>
                <p class="case-desc">{c.descripcion}</p>
                <span class="case-go">
                  Visitar {dominio(c.url)} <span class="arrow" aria-hidden="true">↗</span>
                  <span class="sr-only">(abre en una pestaña nueva)</span>
                </span>
              </div>
            </a>
          </li>
        );
      })}
    </ol>
  </div>
</section>

<style>
  .portafolio { padding-bottom: 72px; }
  .port-intro { padding-block: 40px; row-gap: 20px; }
  .port-h { grid-column: 1 / -1; font-size: clamp(1.75rem, 0.9rem + 3.4vw, 4.25rem); max-width: 16ch; }
  .port-lead { grid-column: 1 / -1; max-width: 44ch; font-size: var(--t-base); align-self: end; }

  .cases { display: grid; gap: 56px; }
  .case-link { display: grid; gap: 20px; text-decoration: none; }
  .case-frame { border: 1px solid var(--line-2); background: var(--bg-2); overflow: hidden; transition: border-color 0.3s; }
  .case-bar { display: flex; align-items: center; gap: 10px; height: 32px; padding: 0 12px; border-bottom: 1px solid var(--line-2); }
  .dot { width: 8px; height: 8px; background: var(--violet); }
  .case-img { aspect-ratio: 16 / 9.2; overflow: hidden; }
  .case-img :global(img) { width: 100%; height: auto; }
  .case-missing { display: grid; place-items: center; height: 100%; }

  .case-meta { display: grid; gap: 8px; align-content: start; }
  .case-name { font-size: clamp(1.75rem, 1.2rem + 2.4vw, 3.25rem); }
  .case-desc { max-width: 40ch; }
  .case-go {
    justify-self: start; margin-top: 8px;
    display: inline-flex; gap: 10px; align-items: center;
    padding-bottom: 4px; border-bottom: 1px solid var(--violet);
    text-transform: uppercase; letter-spacing: 0.04em; font-size: var(--t-xs); font-weight: 600;
  }
  .case-go .arrow { display: inline-block; transition: transform 0.4s var(--ease-out); }
  .case-link:hover .case-go .arrow, .case-link:focus-visible .case-go .arrow { transform: translate(4px, -4px); }
  .case-link:hover .case-frame, .case-link:focus-visible .case-frame { border-color: var(--violet); }

  @media (min-width: 768px) {
    .portafolio { padding-bottom: 112px; }
    .port-intro { padding-block: 56px; }
    .port-h { grid-column: 1 / span 5; }
    .port-lead { grid-column: 6 / -1; }
    .cases { grid-template-columns: repeat(8, minmax(0, 1fr)); column-gap: var(--gutter); row-gap: 80px; }
    .case--0 { grid-column: 1 / -1; }
    .case--0 .case-link { grid-template-columns: repeat(8, minmax(0, 1fr)); column-gap: var(--gutter); }
    .case--0 .case-fig { grid-column: 1 / span 5; }
    .case--0 .case-meta { grid-column: 6 / -1; align-self: end; }
    .case--1 { grid-column: 1 / span 4; }
    .case--2 { grid-column: 5 / -1; margin-top: 120px; }
  }
  @media (min-width: 1200px) {
    .cases { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .case--0 .case-link { grid-template-columns: repeat(12, minmax(0, 1fr)); }
    .case--0 .case-fig { grid-column: 1 / span 8; }
    .case--0 .case-meta { grid-column: 10 / -1; }
    .case--1 { grid-column: 2 / span 5; }
    .case--2 { grid-column: 8 / -1; margin-top: 160px; }
  }
</style>
